# NAPPS North Central Zone Portal - Environment Variables
# Copy this file to .env and fill in your actual values

# =============== API CONFIGURATION ===============
# Backend API URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# =============== SUPABASE CONFIGURATION (if using) ===============
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# =============== OPAY PAYMENT GATEWAY ===============
# Opay API credentials (get from https://opayweb.com)
VITE_OPAY_API_KEY=your_opay_api_key
VITE_OPAY_MERCHANT_ID=your_opay_merchant_id
VITE_OPAY_ENV=sandbox  # Change to 'production' for live

# =============== DUES CONFIGURATION ===============
# North Central Zone Dues Structure (in Naira)
# Local Dues: ₦6,000
# State Dues: ₦4,000
# Zonal Dues: ₦2,000
# National Dues: ₦5,000
# NAPPS ID Card: ₦3,500
# Total: ₦20,500

# Operational Deductions (in Naira)
# National: ₦1,500 (System maintenance)
# Zonal: ₦500 (Coordination)
# State: ₦1,000 (ICT operations)
# Total Deductions: ₦3,000

# =============== SCHOOL ID CONFIGURATION ===============
# Prefix for unique school IDs (North Central = NC)
VITE_SCHOOL_ID_PREFIX=NC
VITE_SCHOOL_ID_LENGTH=8

# =============== QR CODE CONFIGURATION ===============
# For ID card generation
VITE_QR_CODE_SIZE=200
VITE_QR_CODE_MARGIN=2

# =============== DEVELOPMENT CONFIGURATION ===============
# Port for development server (default: 5173)
# VITE_PORT=5173

# Environment mode
NODE_ENV=development

# =============== PRODUCTION CONFIGURATION ===============
# For production deployment, update these values:
# VITE_API_BASE_URL=https://your-production-api.com/api/v1
# VITE_OPAY_ENV=production
# NODE_ENV=production
